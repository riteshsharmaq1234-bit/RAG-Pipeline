# ===========================================================================
# RAG Document Q&A API - Environment variables
# Copy this file to ".env" and adjust the values for your environment.
# ===========================================================================

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/rag_db

# --- JWT / Authentication --------------------------------------------------
# Use a long, random secret in production (e.g. `openssl rand -hex 32`).
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- OpenAI (optional) -----------------------------------------------------
# Leave blank to use the offline fallback (returns the most relevant chunk).
OPENAI_API_KEY=

# --- ChromaDB --------------------------------------------------------------
CHROMA_PATH=./chroma_db
